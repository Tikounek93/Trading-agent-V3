/atlas_state/
/docs/atlas/change-packs/
/docs/atlas/change-reports/

# Local source and runtime data. Keep code, schemas and source-link lists in Git.
/data/artifacts/
/data/raw/
/data/catalog/*.sqlite3
/data/catalog/*.sqlite3-*
/data/datasets/
/data/knowledge/
/data/market/
/data/processed/
/data/research/

# Editor and operating-system files
.DS_Store
.idea/
.vscode/
